{
  "info": {
    "name": "SimpleVerifier API",
    "description": "Public API: https://simpleverifier.com/docs/api. Set the apiKey variable to a key from https://simpleverifier.com/api-keys. 120 calls a minute per key; 429 carries Retry-After; 402 means no API access on the plan or the yearly quota is used.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Verify email (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/verify?email=jane@company.com",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "verify"
          ],
          "query": [
            {
              "key": "email",
              "value": "jane@company.com"
            }
          ]
        }
      }
    },
    {
      "name": "Verify email (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "verify"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane@company.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Validate phone (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/phone?phone=07911 123456&country=GB",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "phone"
          ],
          "query": [
            {
              "key": "phone",
              "value": "07911 123456"
            },
            {
              "key": "country",
              "value": "GB"
            }
          ]
        }
      }
    },
    {
      "name": "Validate phone (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/phone",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "phone"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"07911 123456\",\n  \"country\": \"GB\",\n  \"live\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Account: key and plan check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "me"
          ],
          "query": []
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://simpleverifier.com"
    },
    {
      "key": "apiKey",
      "value": "sv_live_REPLACE_ME"
    }
  ]
}